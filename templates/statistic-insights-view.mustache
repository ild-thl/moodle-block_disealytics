<style>
    .block_disealytics .insights-general {
        background: var(--light);
        border-radius: 8px;
        padding: 8px;
        height: 100%;
    }

    @keyframes fadeInOut {
        0%, 100% {
            opacity: .7;
        }
        50% {
            opacity: .3;
        }
    }

    .block_disealytics .activitiesdue {
        color: white;
        background: var(--danger);
        opacity: .7;
        animation: fadeInOut 2s ease-in-out 3;
    }

    .block_disealytics .noactivitiesdue {
        color: white;
        background: var(--green);
    }

    .block_disealytics .progress-wrapper {
        position: relative;
        display: flex;
        justify-content: space-around;
        gap: 8px;
    }

    .block_disealytics .progressbar-explanation div {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .block_disealytics .progressbar-circle {
        position: relative;
        width: min-content;
    }

    .block_disealytics .progressbar-cognitive {
        --size: 5rem;
        --fg: var(--primary);
        --bg: color-mix(in srgb, var(--fg) 30%, transparent); /* Lighter version of fg */
    }

    .block_disealytics .progressbar-social {
        --size: 5rem;
        --fg: var(--orange);
        --bg: color-mix(in srgb, var(--fg) 30%, transparent); /* Lighter version of fg */
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.75);
    }

    @property --pgPercentage {
        syntax: '<number>';
        inherits: false;
        initial-value: 0;
    }

    .block_disealytics div[role="progressbar"] {
        --pgPercentage: var(--value);
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: radial-gradient(closest-side, white 80%, transparent 0 99.9%, white 0),
        conic-gradient(var(--fg) calc(var(--pgPercentage) * 1%), var(--bg) 0);
        font-size: calc(var(--size) / 5);
        color: var(--fg);
    }
</style>

